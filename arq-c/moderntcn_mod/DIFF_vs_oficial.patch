+class PatchAttention(nn.Module):
+    """[MODIFICAÇÃO CP02] auto-atenção sobre os patches de cada variável, com ganho inicial zero (ReZero).
+    Em x + gamma * Attn(LN(x)) com gamma=0 o bloco começa idêntico ao oficial.
+    Tokens = os N patches (84 em ETTh2) de cada variável; cada variável é tratada em separado."""
+    def __init__(self, dmodel, n_patches, heads=4, drop=0.1):
+        super(PatchAttention, self).__init__()
+        self.norm = nn.LayerNorm(dmodel)
+        self.pos = nn.Parameter(torch.zeros(1, n_patches, dmodel))
+        nn.init.trunc_normal_(self.pos, std=0.02)
+        self.attn = nn.MultiheadAttention(dmodel, heads, dropout=drop, batch_first=True)
+        self.gamma = nn.Parameter(torch.zeros(1))
+
+    def forward(self, x):  # x: [B, M, D, N]
+        B, M, D, N = x.shape
+        z = x.permute(0, 1, 3, 2).reshape(B * M, N, D)       # tokens = patches
+        h = self.norm(z) + self.pos[:, :N]
+        h, _ = self.attn(h, h, h, need_weights=False)
+        z = z + self.gamma * h
+        return z.reshape(B, M, N, D).permute(0, 1, 3, 2)
+
